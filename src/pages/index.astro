---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { apps, openSource, outsideTheAppStore, profile } from '@/data/site';
---
<SiteLayout>
  <div id="top" class="page-shell">
    <SiteNav />
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Good ideas<br />deserve <em>to ship.</em></h1>
          <p class="hero-intro">I build iOS apps, small games, and developer tools.</p>
          <a class="button button-dark" href="#work">View the apps <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-art" aria-label="A glimpse of PLNK, a pachinko inspired game">
          <div class="board-frame"><div class="board-glow"></div><img src="/images/apps/plnk-screen.jpg" alt="" fetchpriority="high" /></div>
          <div class="floating-note"><span class="note-glyph">↘</span><span>Find your line.<br /><strong>Make it count.</strong></span></div>
          <span class="hero-orbit orbit-one"></span>
        </div>
      </section>

      <section id="work" class="work-section section-wrap" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">Built solo.</h2>
        </div>
        <div class="project-grid">
          {apps.map((app, index) => <ProjectCard app={app} index={index} />)}
        </div>
      </section>

      <section id="open-source" class="opensource-section section-wrap" aria-labelledby="open-title">
        <div class="opensource-label"><span class="eyebrow">OPEN SOURCE</span></div>
        <div class="opensource-main">
          <div class="terminal-mark" aria-hidden="true"><span>$_</span><i></i><i></i><i></i></div>
          <div class="opensource-copy">
            <h2 id="open-title">{openSource.name}<span class="period">.</span></h2>
            <p>{openSource.description}</p>
            <div class="gem-downloads" role="status" aria-live="polite" data-gem-downloads-api={openSource.downloadsApi}>
              <strong data-download-count>Loading</strong><span>total downloads on RubyGems</span>
            </div>
          </div>
          <div class="open-links">{openSource.links.map(link => <a class="button button-light" href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}</div>
        </div>
      </section>

      <section id="elsewhere" class="other-section section-wrap" aria-labelledby="other-title">
        <div class="section-heading compact-heading">
          <div><p class="eyebrow">Away from the screen</p><h2 id="other-title">A few other <em>interests.</em></h2></div>
        </div>
        <div class="interest-grid">
          {outsideTheAppStore.map(item => <a class="interest-card" href={item.href} target="_blank" rel="noreferrer"><span class="interest-mark" aria-hidden="true">{item.mark}</span><span class="interest-copy"><strong>{item.label}</strong><small>{item.note}</small></span><span class="interest-arrow" aria-hidden="true">↗</span></a>)}
        </div>
      </section>

      <section id="about" class="about-section section-wrap" aria-labelledby="about-title">
        <p class="eyebrow">A note from Mike</p>
        <div class="about-body"><h2 id="about-title">Hi, I’m Mike.</h2><div>{profile.bio.map(paragraph => <p>{paragraph}</p>)}<div class="social-links">{profile.links.map(link => <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></div></div>
      </section>
    </main>
    <footer class="site-footer"><a class="wordmark" href="#top"><span>{profile.domain}</span></a><span>Designed and built with care.</span><a href="https://www.linkedin.com/in/mjmacdougall/" target="_blank" rel="noreferrer">Get in touch <span aria-hidden="true">↗</span></a><span class="copyright">© {new Date().getFullYear()} Mike MacDougall</span></footer>
  </div>
</SiteLayout>

<script>
  const downloadCount = document.querySelector<HTMLElement>('[data-download-count]');
  const downloadsContainer = document.querySelector<HTMLElement>('[data-gem-downloads-api]');
  const downloadsApi = downloadsContainer?.dataset.gemDownloadsApi;

  if (downloadCount && downloadsApi) {
    try {
      const response = await fetch(downloadsApi, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('RubyGems request failed');

      const gem = await response.json() as { downloads?: number };
      if (typeof gem.downloads !== 'number') throw new Error('RubyGems returned no total');

      downloadCount.textContent = new Intl.NumberFormat('en-US').format(gem.downloads);
    } catch {
      downloadCount.textContent = 'Unavailable';
    }
  }
</script>
