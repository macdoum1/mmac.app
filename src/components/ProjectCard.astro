---
const { app, index = 0 } = Astro.props;
---
<article class:list={['project-card', app.featured && 'project-card-featured', app.name === 'TapTapCount' && 'project-card-taptapcount', app.name === 'PLNK' && 'project-card-plnk', app.name === 'Recipe Hound' && 'project-card-recipe-hound', app.name === 'Verdant Ledger' && 'project-card-verdant-ledger']} style={`--card-index:${index}`}>
  <a class="project-visual" href={app.href} target="_blank" rel="noreferrer" aria-label={`View ${app.name} on the App Store`}>
    <img class="project-icon" src={app.icon} alt="" loading="lazy" />
    <span class="project-screen-frame"><img class="project-screen" src={app.image} alt={app.imageAlt} loading="lazy" /></span>
    <span class="visual-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-copy">
    <div class="project-meta"><span>{app.category}</span><span>{app.year}</span></div>
    <h3>{app.name}</h3>
    <p class="project-subtitle">{app.subtitle}</p>
    <p class="project-description">{app.description}</p>
    <div class="project-links">
      <a class="text-link" href={app.href} target="_blank" rel="noreferrer">View on the App Store <span aria-hidden="true">↗</span></a>
      {app.privacyHref && <a class="text-link" href={app.privacyHref}>Privacy policy</a>}
    </div>
  </div>
</article>
