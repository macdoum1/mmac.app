---
const { app, index = 0 } = Astro.props;
---
<article class:list={['project-card', app.featured && 'project-card-featured']} style={`--card-index:${index}`}>
  <a class="project-visual" href={app.href} target="_blank" rel="noreferrer" aria-label={`View ${app.name} on the App Store`}>
    <img class="project-icon" src={app.icon} alt="" loading="lazy" />
    <img class="project-screen" src={app.image} alt={app.imageAlt} loading="lazy" />
    <span class="visual-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-copy">
    <div class="project-meta"><span>{app.category}</span><span>{app.year}</span></div>
    <h3>{app.name}</h3>
    <p class="project-subtitle">{app.subtitle}</p>
    <p class="project-description">{app.description}</p>
    <a class="text-link" href={app.href} target="_blank" rel="noreferrer">View on the App Store <span aria-hidden="true">↗</span></a>
  </div>
</article>
