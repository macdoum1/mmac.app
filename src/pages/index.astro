---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { apps, nextUp, openSource, outsideTheAppStore, profile } from '@/data/site';
---
<SiteLayout>
  <div id="top" class="page-shell">
    <SiteNav />
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> Independent developer · New York</p>
          <h1 id="hero-title">Good ideas<br />deserve <em>to ship.</em></h1>
          <p class="hero-intro">I’m Mike. I build thoughtful apps, playful games, and tools that make everyday things a little better.</p>
          <a class="button button-dark" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero-art" aria-label="A glimpse of PLNK, a pachinko inspired game">
          <div class="art-caption"><span>01 / IN MOTION</span><span>PLNK · 30 DROPS</span></div>
          <div class="board-frame"><div class="board-glow"></div><img src="/images/apps/plnk-screen.jpg" alt="" fetchpriority="high" /></div>
          <div class="floating-note"><span class="note-glyph">↘</span><span>Find your line.<br /><strong>Make it count.</strong></span></div>
          <span class="hero-orbit orbit-one"></span><span class="hero-orbit orbit-two"></span>
        </div>
        <div class="hero-index"><span>SELECTED WORK</span><span>01—04</span></div>
      </section>

      <section id="work" class="work-section section-wrap" aria-labelledby="work-title">
        <div class="section-heading">
          <div><p class="eyebrow">A few things I’ve made</p><h2 id="work-title">Small teams.<br /><em>Personal projects.</em></h2></div>
          <p class="section-intro">From arcade runs to recipe imports, each one starts with a small problem worth solving.</p>
        </div>
        <div class="project-grid">
          {apps.map((app, index) => <ProjectCard app={app} index={index} />)}
        </div>
      </section>

      <section class="opensource-section section-wrap" aria-labelledby="open-title">
        <div class="opensource-label"><span class="eyebrow">OPEN SOURCE</span><span class="open-index">01 / 01</span></div>
        <div class="opensource-main">
          <div class="terminal-mark" aria-hidden="true"><span>$_</span><i></i><i></i><i></i></div>
          <div class="opensource-copy"><h2 id="open-title">{openSource.name}<span class="period">.</span></h2><p>{openSource.description}</p></div>
          <div class="open-links">{openSource.links.map(link => <a class="button button-light" href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}</div>
        </div>
      </section>

      <section class="other-section section-wrap" aria-labelledby="other-title">
        <div class="section-heading compact-heading">
          <div><p class="eyebrow">Away from the screen</p><h2 id="other-title">A few other <em>interests.</em></h2></div>
          <p class="section-intro">Making things takes many forms.</p>
        </div>
        <div class="interest-grid">
          {outsideTheAppStore.map(item => <a class="interest-card" href={item.href} target="_blank" rel="noreferrer"><span class="interest-mark" aria-hidden="true">{item.mark}</span><span class="interest-copy"><strong>{item.label}</strong><small>{item.note}</small></span><span class="interest-arrow" aria-hidden="true">↗</span></a>)}
        </div>
      </section>

      <section class="next-section" aria-label="Future work">
        <div class="next-orbit" aria-hidden="true"><span>+</span><i></i></div>
        <div><p class="eyebrow">THE NEXT THING</p><h2>{nextUp.title}</h2><p>{nextUp.description}</p></div>
        <span class="next-coordinate" aria-hidden="true">40° 43′ N<br />73° 59′ W</span>
      </section>

      <section id="about" class="about-section section-wrap" aria-labelledby="about-title">
        <p class="eyebrow">A note from Mike</p>
        <div class="about-body"><h2 id="about-title">Hi, I’m Mike.<br /><em>I like making things.</em></h2><div><p>{profile.intro} This is where I keep the work I’m proud to share.</p><div class="social-links">{profile.links.map(link => <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></div></div>
      </section>
    </main>
    <footer class="site-footer"><a class="wordmark" href="#top"><span class="wordmark-mark">m.</span><span>{profile.domain}</span></a><span>Designed and built with care.</span><a href="https://www.linkedin.com/in/mjmacdougall/" target="_blank" rel="noreferrer">Get in touch <span aria-hidden="true">↗</span></a><span class="copyright">© {new Date().getFullYear()} Mike MacDougall</span></footer>
  </div>
</SiteLayout>
