---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SiteNav from '@/components/SiteNav.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { apps, openSource, outsideTheAppStore, profile } from '@/data/site';
---
<SiteLayout>
  <div id="top" class="page-shell">
    <SiteNav />
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">Good ideas<br />deserve <em>to ship.</em></h1>
          <p class="hero-intro">I build iOS apps, small games, and developer tools.</p>
          <a class="button button-dark" href="#work">View the apps <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section id="work" class="work-section section-wrap" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title">Built solo.</h2>
        </div>
        <div class="project-grid">
          {apps.map((app, index) => <ProjectCard app={app} index={index} />)}
        </div>
      </section>

      <section id="open-source" class="opensource-section section-wrap" aria-labelledby="open-title">
        <div class="opensource-label"><span class="eyebrow">OPEN SOURCE</span></div>
        <div class="opensource-main">
          <div class="terminal-mark" aria-hidden="true"><span>$_</span><i></i><i></i><i></i></div>
          <div class="opensource-copy">
            <h2 id="open-title">{openSource.name}<span class="period">.</span></h2>
            <p>{openSource.description}</p>
            <div class="gem-downloads" role="status" aria-live="polite" data-gem-downloads-api={openSource.downloadsApi} data-fallback-downloads={openSource.fallbackDownloads}>
              <strong data-download-count>{openSource.fallbackDownloads.toLocaleString('en-US')}</strong><span data-download-label>last known downloads on RubyGems</span>
            </div>
          </div>
          <div class="open-links">{openSource.links.map(link => <a class="button button-light" href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true">↗</span></a>)}</div>
        </div>
      </section>

      <section id="elsewhere" class="other-section section-wrap" aria-labelledby="other-title">
        <div class="section-heading compact-heading">
          <div><p class="eyebrow">Away from the screen</p><h2 id="other-title">A few other <em>interests.</em></h2></div>
        </div>
        <div class="interest-grid">
          {outsideTheAppStore.map(item => <a class="interest-card" href={item.href} target="_blank" rel="noreferrer">
            <span class="interest-art interest-collage" aria-hidden="true">{item.photos.map(photo => <img src={photo.src} alt="" loading="lazy" />)}</span>
            <span class="interest-copy"><strong>{item.label}</strong><small>{item.note}</small></span><span class="interest-arrow" aria-hidden="true">↗</span>
          </a>)}
        </div>
      </section>

      <section id="about" class="about-section section-wrap" aria-labelledby="about-title">
        <p class="eyebrow">A note from Mike</p>
        <div class="about-body"><h2 id="about-title">Hi, I’m Mike.</h2><div>{profile.bio.map(paragraph => <p>{paragraph}</p>)}<div class="social-links">{profile.links.map(link => <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></div></div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-identity">
        <a class="wordmark footer-brand" href="#top" aria-label={`${profile.name}, back to top`}><span>{profile.domain}</span></a>
        <span class="footer-copyright">© {new Date().getFullYear()} {profile.name}</span>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/privacy/">Privacy policies</a>
        <a href="https://www.linkedin.com/in/mjmacdougall/" target="_blank" rel="noreferrer" aria-label="Contact Mike on LinkedIn">LinkedIn <span aria-hidden="true">↗</span></a>
      </nav>
    </footer>
  </div>
</SiteLayout>

<script>
  const downloadCount = document.querySelector<HTMLElement>('[data-download-count]');
  const downloadLabel = document.querySelector<HTMLElement>('[data-download-label]');
  const downloadsContainer = document.querySelector<HTMLElement>('[data-gem-downloads-api]');
  const downloadsApi = downloadsContainer?.dataset.gemDownloadsApi;
  const fallbackDownloads = Number(downloadsContainer?.dataset.fallbackDownloads);
  const cacheKey = 'mmac.app:howsigned:downloads';

  const formatCount = (count: number) => new Intl.NumberFormat('en-US').format(count);
  const isValidCount = (count: number) => Number.isSafeInteger(count) && count >= 0;

  if (downloadCount && isValidCount(fallbackDownloads)) {
    downloadCount.textContent = formatCount(fallbackDownloads);
    try {
      const storedCount = localStorage.getItem(cacheKey);
      const cachedCount = storedCount === null ? Number.NaN : Number(storedCount);
      if (isValidCount(cachedCount)) downloadCount.textContent = formatCount(cachedCount);
    } catch {
      // Keep the baked-in fallback when browser storage is unavailable.
    }
  }

  if (downloadCount && downloadsApi) {
    try {
      const response = await fetch(downloadsApi, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('RubyGems request failed');

      const gem = await response.json() as { downloads?: number };
      if (typeof gem.downloads !== 'number') throw new Error('RubyGems returned no total');

      downloadCount.textContent = formatCount(gem.downloads);
      if (downloadLabel) downloadLabel.textContent = 'total downloads on RubyGems';
      try {
        localStorage.setItem(cacheKey, String(gem.downloads));
      } catch {
        // The live count still works when browser storage is unavailable.
      }
    } catch {
      if (downloadLabel) downloadLabel.textContent = 'last known downloads on RubyGems';
    }
  }
</script>
